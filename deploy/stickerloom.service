[Unit]
Description=Stickerloom Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/projects/stickerloom
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/stickerloom/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
